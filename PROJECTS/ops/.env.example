# ==============================================================================
# Pipeline Deployment Configuration Template
# ==============================================================================
# Copy this file to: ops/.env
# Then edit with your actual email and server settings
# ==============================================================================

# Email Configuration (for failure alerts)
# ==============================================================================
# SMTP Server settings for sending alert emails

# For Office 365 / Outlook
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587

# For Gmail
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# Your email address (sender)
SMTP_USERNAME=your-email@company.com

# App-specific password (not your regular password)
# Office 365: https://account.activedirectory.windowsazure.com/
# Gmail: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password-here

# Who to send alerts to (comma-separated)
ALERT_RECIPIENTS=ops@company.com,devops@company.com

# Sender email address (can be same as SMTP_USERNAME)
ALERT_SENDER=pipeline-alerts@company.com


# Server Configuration
# ==============================================================================
# Folder monitoring and pipeline settings

# How often to check for new files (seconds)
MONITOR_INTERVAL=10

# Maximum concurrent pipeline runs (usually 1)
MAX_CONCURRENT_RUNS=1

# How many days of logs to keep
LOG_RETENTION_DAYS=90


# Dashboard Configuration
# ==============================================================================
# Web interface for monitoring

# Port to run dashboard on
DASHBOARD_PORT=5000

# Listen address (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
DASHBOARD_HOST=0.0.0.0


# Debug (optional)
# ==============================================================================
# DEBUG=True
# FLASK_ENV=development
